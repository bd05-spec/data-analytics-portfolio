{
  "name": "CMS_HCAHPS_National",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "tables": [
      {
        "name": "FactHCAHPS",
        "partitions": [
          {
            "name": "FactHCAHPS",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"..\\\\..\\\\data\\\\cleaned\\\\CMS_HCAHPS_National_cleaned_data.csv\"),[Delimiter=\",\", Columns=9, Encoding=1252, QuoteStyle=QuoteStyle.None]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])",
                "in",
                "    PromotedHeaders"
              ]
            }
          }
        ],
        "columns": [
          {
            "name": "hcahps_measure_id",
            "dataType": "string",
            "sourceColumn": "hcahps_measure_id",
            "isHidden": true
          },
          {
            "name": "hcahps_question",
            "dataType": "string",
            "sourceColumn": "hcahps_question"
          },
          {
            "name": "hcahps_answer_description",
            "dataType": "string",
            "sourceColumn": "hcahps_answer_description"
          },
          {
            "name": "hcahps_answer_percent",
            "dataType": "int64",
            "sourceColumn": "hcahps_answer_percent",
            "formatString": "0"
          },
          {
            "name": "footnote",
            "dataType": "double",
            "sourceColumn": "footnote"
          },
          {
            "name": "start_date",
            "dataType": "dateTime",
            "sourceColumn": "start_date",
            "formatString": "Short Date"
          },
          {
            "name": "end_date",
            "dataType": "dateTime",
            "sourceColumn": "end_date",
            "formatString": "Short Date"
          },
          {
            "name": "question_group",
            "dataType": "string",
            "sourceColumn": "question_group"
          },
          {
            "name": "response_code",
            "dataType": "string",
            "sourceColumn": "response_code"
          },
          {
            "name": "Is Top Box",
            "dataType": "int64",
            "type": "calculated",
            "expression": "IF(FactHCAHPS[response_code] = \"A\", 1, 0)"
          },
          {
            "name": "Response Tier",
            "dataType": "string",
            "type": "calculated",
            "expression": "SWITCH(FactHCAHPS[response_code], \"A\", \"Always (top box)\", \"U\", \"Usually\", \"SN\", \"Sometimes/Never\", \"Y\", \"Yes\", \"N\", \"No\", \"Other\")"
          }
        ],
        "measures": [
          {
            "name": "Measures",
            "expression": "COUNTROWS(FactHCAHPS)",
            "formatString": "#,0"
          },
          {
            "name": "Question Groups",
            "expression": "DISTINCTCOUNT(FactHCAHPS[question_group])",
            "formatString": "#,0"
          },
          {
            "name": "Top Box Percent",
            "expression": "CALCULATE(MAX(FactHCAHPS[hcahps_answer_percent]), FactHCAHPS[response_code] = \"A\")",
            "formatString": "0"
          },
          {
            "name": "Average Published Response Percent",
            "expression": "AVERAGE(FactHCAHPS[hcahps_answer_percent])",
            "formatString": "0.0"
          },
          {
            "name": "Groups Reconciling to 100",
            "expression": "COUNTROWS(FILTER(SUMMARIZE(FactHCAHPS, FactHCAHPS[question_group], \"s\", SUM(FactHCAHPS[hcahps_answer_percent])), [s] = 100))",
            "formatString": "#,0",
            "description": "Notebook check: every question group's response percentages must sum to exactly 100. Expected 18 of 18."
          }
        ]
      },
      {
        "name": "QuestionGroup",
        "columns": [
          {
            "name": "question_group",
            "dataType": "string",
            "sourceColumn": "question_group"
          }
        ],
        "partitions": [
          {
            "name": "QuestionGroup",
            "source": {
              "type": "calculated",
              "expression": "DISTINCT(FactHCAHPS[question_group])"
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "FactHCAHPS_QuestionGroup",
        "fromTable": "FactHCAHPS",
        "fromColumn": "question_group",
        "toTable": "QuestionGroup",
        "toColumn": "question_group",
        "crossFilteringBehavior": "oneDirection"
      }
    ]
  }
}