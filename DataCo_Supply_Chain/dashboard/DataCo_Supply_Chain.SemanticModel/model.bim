{
  "name": "DataCo_Supply_Chain",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "tables": [
      {
        "name": "FactOrderItem",
        "partitions": [
          {
            "name": "FactOrderItem",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"..\\\\..\\\\data\\\\cleaned\\\\DataCo_Supply_Chain_cleaned_data.csv\"),[Delimiter=\",\", Columns=47, Encoding=1252, QuoteStyle=QuoteStyle.None]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])",
                "in",
                "    PromotedHeaders"
              ]
            }
          }
        ],
        "columns": [
          {
            "name": "Order Item Id",
            "dataType": "int64",
            "sourceColumn": "Order Item Id",
            "isHidden": true
          },
          {
            "name": "Order Id",
            "dataType": "int64",
            "sourceColumn": "Order Id"
          },
          {
            "name": "Order Customer Id",
            "dataType": "int64",
            "sourceColumn": "Order Customer Id"
          },
          {
            "name": "order date (DateOrders)",
            "dataType": "dateTime",
            "sourceColumn": "order date (DateOrders)",
            "formatString": "Short Date"
          },
          {
            "name": "shipping date (DateOrders)",
            "dataType": "dateTime",
            "sourceColumn": "shipping date (DateOrders)",
            "formatString": "Short Date"
          },
          {
            "name": "Benefit per order",
            "dataType": "double",
            "sourceColumn": "Benefit per order",
            "formatString": "$#,0.00"
          },
          {
            "name": "Sales per customer",
            "dataType": "double",
            "sourceColumn": "Sales per customer",
            "formatString": "$#,0.00"
          },
          {
            "name": "Delivery Status",
            "dataType": "string",
            "sourceColumn": "Delivery Status"
          },
          {
            "name": "Late_delivery_risk",
            "dataType": "int64",
            "sourceColumn": "Late_delivery_risk"
          },
          {
            "name": "Category Name",
            "dataType": "string",
            "sourceColumn": "Category Name"
          },
          {
            "name": "Market",
            "dataType": "string",
            "sourceColumn": "Market"
          },
          {
            "name": "Order Region",
            "dataType": "string",
            "sourceColumn": "Order Region"
          },
          {
            "name": "Order Status",
            "dataType": "string",
            "sourceColumn": "Order Status"
          },
          {
            "name": "Customer Country",
            "dataType": "string",
            "sourceColumn": "Customer Country"
          },
          {
            "name": "Customer Segment",
            "dataType": "string",
            "sourceColumn": "Customer Segment"
          },
          {
            "name": "Department Name",
            "dataType": "string",
            "sourceColumn": "Department Name"
          },
          {
            "name": "Product Name",
            "dataType": "string",
            "sourceColumn": "Product Name"
          },
          {
            "name": "Sales",
            "dataType": "double",
            "sourceColumn": "Sales",
            "formatString": "$#,0.00"
          },
          {
            "name": "Order Profit Per Order",
            "dataType": "double",
            "sourceColumn": "Order Profit Per Order",
            "formatString": "$#,0.00"
          },
          {
            "name": "Is Late Risk",
            "dataType": "int64",
            "type": "calculated",
            "expression": "IF(FactOrderItem[Late_delivery_risk] = 1, 1, 0)"
          }
        ],
        "measures": [
          {
            "name": "Order Items",
            "expression": "COUNTROWS(FactOrderItem)",
            "formatString": "#,0"
          },
          {
            "name": "Orders",
            "expression": "DISTINCTCOUNT(FactOrderItem[Order Id])",
            "formatString": "#,0"
          },
          {
            "name": "Sales",
            "expression": "SUM(FactOrderItem[Sales])",
            "formatString": "$#,0.00"
          },
          {
            "name": "Order Profit",
            "expression": "SUM(FactOrderItem[Order Profit Per Order])",
            "formatString": "$#,0.00"
          },
          {
            "name": "Profit Margin",
            "expression": "DIVIDE([Order Profit], [Sales])",
            "formatString": "0.00%"
          },
          {
            "name": "Late Items",
            "expression": "CALCULATE([Order Items], FactOrderItem[Late_delivery_risk] = 1)",
            "formatString": "#,0"
          },
          {
            "name": "Late Risk Rate",
            "expression": "DIVIDE([Late Items], [Order Items])",
            "formatString": "0.00%"
          },
          {
            "name": "Avg Sales per Order",
            "expression": "DIVIDE([Sales], [Orders])",
            "formatString": "$#,0.00"
          }
        ]
      }
    ]
  }
}