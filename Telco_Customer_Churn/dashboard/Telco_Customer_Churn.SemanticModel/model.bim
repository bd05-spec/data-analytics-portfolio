{
  "name": "Telco_Customer_Churn",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "tables": [
      {
        "name": "Telco_Customer",
        "partitions": [
          {
            "name": "Telco_Customer",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(\"..\\\\..\\\\data\\\\cleaned\\\\Telco_Customer_Churn_cleaned_data.csv\"),[Delimiter=\",\", Columns=21, Encoding=1252, QuoteStyle=QuoteStyle.None]),",
                "    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true])",
                "in",
                "    PromotedHeaders"
              ]
            }
          }
        ],
        "columns": [
          {
            "name": "customerID",
            "dataType": "string",
            "sourceColumn": "customerID",
            "isHidden": true
          },
          {
            "name": "gender",
            "dataType": "string",
            "sourceColumn": "gender"
          },
          {
            "name": "SeniorCitizen",
            "dataType": "int64",
            "sourceColumn": "SeniorCitizen"
          },
          {
            "name": "Partner",
            "dataType": "string",
            "sourceColumn": "Partner"
          },
          {
            "name": "Dependents",
            "dataType": "string",
            "sourceColumn": "Dependents"
          },
          {
            "name": "tenure",
            "dataType": "int64",
            "sourceColumn": "tenure"
          },
          {
            "name": "PhoneService",
            "dataType": "string",
            "sourceColumn": "PhoneService"
          },
          {
            "name": "MultipleLines",
            "dataType": "string",
            "sourceColumn": "MultipleLines"
          },
          {
            "name": "InternetService",
            "dataType": "string",
            "sourceColumn": "InternetService"
          },
          {
            "name": "OnlineSecurity",
            "dataType": "string",
            "sourceColumn": "OnlineSecurity"
          },
          {
            "name": "OnlineBackup",
            "dataType": "string",
            "sourceColumn": "OnlineBackup"
          },
          {
            "name": "DeviceProtection",
            "dataType": "string",
            "sourceColumn": "DeviceProtection"
          },
          {
            "name": "TechSupport",
            "dataType": "string",
            "sourceColumn": "TechSupport"
          },
          {
            "name": "StreamingTV",
            "dataType": "string",
            "sourceColumn": "StreamingTV"
          },
          {
            "name": "StreamingMovies",
            "dataType": "string",
            "sourceColumn": "StreamingMovies"
          },
          {
            "name": "Contract",
            "dataType": "string",
            "sourceColumn": "Contract"
          },
          {
            "name": "PaperlessBilling",
            "dataType": "string",
            "sourceColumn": "PaperlessBilling"
          },
          {
            "name": "PaymentMethod",
            "dataType": "string",
            "sourceColumn": "PaymentMethod"
          },
          {
            "name": "MonthlyCharges",
            "dataType": "double",
            "sourceColumn": "MonthlyCharges",
            "formatString": "$#,0.00"
          },
          {
            "name": "TotalCharges",
            "dataType": "double",
            "sourceColumn": "TotalCharges",
            "formatString": "$#,0.00"
          },
          {
            "name": "Churn",
            "dataType": "string",
            "sourceColumn": "Churn"
          },
          {
            "name": "Tenure Band",
            "dataType": "string",
            "type": "calculated",
            "expression": "SWITCH(TRUE(), Telco_Customer[tenure] <= 12, \"0-12 months\", Telco_Customer[tenure] <= 24, \"13-24 months\", Telco_Customer[tenure] <= 48, \"25-48 months\", Telco_Customer[tenure] <= 60, \"49-60 months\", \"61+ months\")"
          },
          {
            "name": "Is Churned",
            "dataType": "int64",
            "type": "calculated",
            "expression": "IF(Telco_Customer[Churn] = \"Yes\", 1, 0)"
          }
        ],
        "measures": [
          {
            "name": "Customers",
            "expression": "COUNTROWS(Telco_Customer)",
            "formatString": "#,0"
          },
          {
            "name": "Churned Customers",
            "expression": "CALCULATE([Customers], Telco_Customer[Churn] = \"Yes\")",
            "formatString": "#,0"
          },
          {
            "name": "Churn Rate",
            "expression": "DIVIDE([Churned Customers], [Customers])",
            "formatString": "0.00%"
          },
          {
            "name": "Average Monthly Charges",
            "expression": "AVERAGE(Telco_Customer[MonthlyCharges])",
            "formatString": "$#,0.00"
          },
          {
            "name": "Average Tenure Months",
            "expression": "AVERAGE(Telco_Customer[tenure])",
            "formatString": "0.0"
          },
          {
            "name": "Total Monthly Revenue",
            "expression": "SUM(Telco_Customer[MonthlyCharges])",
            "formatString": "$#,0.00"
          },
          {
            "name": "Avg Total Charges",
            "expression": "AVERAGE(Telco_Customer[TotalCharges])",
            "formatString": "$#,0.00"
          },
          {
            "name": "New Accounts (tenure=0)",
            "expression": "CALCULATE([Customers], Telco_Customer[tenure] = 0)",
            "formatString": "#,0"
          }
        ]
      }
    ]
  }
}