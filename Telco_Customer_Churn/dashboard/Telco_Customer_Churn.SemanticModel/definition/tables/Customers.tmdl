/// One row per telecom customer (7,043). Snapshot data: there are no dates, so no trend over time is possible.
table Customers
	lineageTag: 7c2d3c2e-f5a1-4022-987b-68fce2555177

	/// Number of customers in context.
	measure 'Customer Count' = COUNTROWS ( Customers )
		formatString: #,##0
		lineageTag: d42fb6cb-66c6-4973-b8c4-3e8b94357f8c

	/// Customers who left in the last month.
	measure 'Churned Customers' = SUM ( Customers[Churn Flag] )
		formatString: #,##0
		lineageTag: 0b34bed4-df43-4128-b654-580003c12dcf

	/// Churned customers / customers. Describes association, not cause.
	measure 'Churn Rate' = DIVIDE ( [Churned Customers], [Customer Count] )
		formatString: 0.0%
		lineageTag: 76455dbc-3888-4b41-afe8-86d3bf7c8ff7

	/// Sum of current monthly charges of churned customers (one month of billing, not lifetime value).
	measure 'Monthly Charges Lost' = CALCULATE ( SUM ( Customers[Monthly Charges] ), Customers[Churn Flag] = 1 )
		formatString: $#,##0
		lineageTag: 595d1064-08dc-40cc-929a-7a6077d00672

	/// Monthly charges lost in context as a share of all customers' monthly charges.
	measure 'Share of Monthly Charges Lost' = DIVIDE ( [Monthly Charges Lost], CALCULATE ( SUM ( Customers[Monthly Charges] ), ALL ( Customers ) ) )
		formatString: 0.0%
		lineageTag: 2880219d-605a-4bdc-b135-3cade97ae878

	/// Highlight colour: orange when churn is 40% or more, teal otherwise.
	measure 'Churn Bar Color' = IF ( [Churn Rate] >= 0.4, "#C2410C", "#0F766E" )
		isHidden
		displayFolder: Formatting
		lineageTag: 9ca345c1-02b6-4a56-967a-58d5a4641dc2

	column 'Customer ID'
		dataType: string
		isHidden
		lineageTag: 46acc225-000b-40e4-8a14-95ca5c8cda42
		sourceColumn: customerID

	/// Yes if the customer is 65 or older.
	column 'Senior Citizen'
		dataType: string
		lineageTag: 4727af0b-f943-4fe1-b45d-3b9aed0b3464
		sourceColumn: Senior Citizen

	/// Customer has a partner.
	column Partner
		dataType: string
		lineageTag: 08532fce-340c-414f-b58e-af1964c82f7d
		sourceColumn: Partner

	/// Customer has dependents.
	column Dependents
		dataType: string
		lineageTag: 945c0a6f-fa2c-4356-bd2b-cdfd664559ac
		sourceColumn: Dependents

	/// Months the customer has been with the company.
	column 'Tenure Months'
		dataType: int64
		lineageTag: 99a1e6b2-ec6a-4568-987a-3f8d3552923a
		summarizeBy: none
		sourceColumn: tenure

	/// Tenure grouped into bands.
	column 'Tenure Band'
		dataType: string
		lineageTag: b9a12049-f8d8-42a3-b13d-cacc01242fe0
		sourceColumn: Tenure Band
		sortByColumn: 'Tenure Band Order'

	column 'Tenure Band Order'
		dataType: int64
		isHidden
		lineageTag: 6d993a9e-d873-4cf4-b281-ee9406674120
		summarizeBy: none
		sourceColumn: Tenure Band Order

	/// DSL, Fiber optic, or No internet.
	column 'Internet Service'
		dataType: string
		lineageTag: 104e6945-0141-4162-87ad-1f6a79c1ee05
		sourceColumn: Internet

	/// Online security add-on: Yes, No, or No internet service.
	column 'Online Security'
		dataType: string
		lineageTag: 39400e7d-d7cd-42d5-8de8-86b0cab72067
		sourceColumn: OnlineSecurity

	/// Tech support add-on: Yes, No, or No internet service.
	column 'Tech Support'
		dataType: string
		lineageTag: 57f2082c-5448-482c-9952-6a6cf4b637f1
		sourceColumn: TechSupport

	/// How many of 4 protective add-ons (online security, online backup, device protection, tech support) an internet customer has.
	column 'Protective Add-ons'
		dataType: string
		lineageTag: 60959b74-b76b-43eb-bdff-c21a50d8a6a5
		sourceColumn: Protective Add-ons
		sortByColumn: 'Add-ons Order'

	column 'Add-ons Order'
		dataType: int64
		isHidden
		lineageTag: 24b01015-bcc3-4973-99cc-226b1e259bff
		summarizeBy: none
		sourceColumn: Add-ons Order

	/// Month-to-month, One year, or Two year.
	column Contract
		dataType: string
		lineageTag: 8edcea4f-5ca6-4f98-b48e-57f8c08d5859
		sourceColumn: Contract
		sortByColumn: 'Contract Order'

	column 'Contract Order'
		dataType: int64
		isHidden
		lineageTag: 59926200-b736-40f4-982e-4e55c1d535d8
		summarizeBy: none
		sourceColumn: Contract Order

	column 'Payment Method'
		dataType: string
		lineageTag: 3c3b576e-9dc8-4906-9d3e-eafbee9747c9
		sourceColumn: PaymentMethod

	column 'Paperless Billing'
		dataType: string
		lineageTag: 56b1dc53-a876-42e8-98d4-6ca7f184304a
		sourceColumn: PaperlessBilling

	/// Current monthly charge in USD.
	column 'Monthly Charges'
		dataType: decimal
		isHidden
		formatString: $#,##0.00
		lineageTag: 3181c18f-aa48-4a7d-bde3-0c0f74df9cbd
		sourceColumn: MonthlyCharges

	/// Yes if the customer left in the last month.
	column Churned
		dataType: string
		lineageTag: 0b81a966-01d3-4d21-bdeb-2c47b198b5ae
		sourceColumn: Churn

	column 'Churn Flag'
		dataType: int64
		isHidden
		lineageTag: 293148ef-9016-41db-943b-166c033f960b
		summarizeBy: none
		sourceColumn: Churn Flag

	column 'Charge Band Order'
		dataType: int64
		isHidden
		lineageTag: 7f007896-4f46-4796-b34b-968648fb2b31
		summarizeBy: none
		sourceColumn: Charge Band Order

	/// Current monthly charge, grouped.
	column 'Charge Band'
		dataType: string
		lineageTag: 70941e48-6edc-40e5-8272-b78d72263c8e
		sourceColumn: Charge Band
		sortByColumn: 'Charge Band Order'

	/// Contract | internet service | payment method.
	column Segment
		dataType: string
		lineageTag: 040ac5b1-a11e-40ca-9176-507bf89c4fd3
		sourceColumn: Segment

	partition Customers = m
		mode: import
		source =
				let
				    Path = "Telco_Customer_Churn/data/cleaned/Telco_Customer_Churn_cleaned_data.csv",
				    Bin = if Text.StartsWith(DataRoot, "http") then Web.Contents(DataRoot & "/" & Path) else File.Contents(DataRoot & "\" & Text.Replace(Path, "/", "\")),
				    Source = Csv.Document(Bin, [Delimiter = ",", Columns = 21, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"tenure", Int64.Type}, {"MonthlyCharges", Currency.Type}, {"SeniorCitizen", Int64.Type}}, "en-US"),
				    Senior = Table.AddColumn(Typed, "Senior Citizen", each if [SeniorCitizen] = 1 then "Yes" else "No", type text),
				    Band = Table.AddColumn(Senior, "Tenure Band", each if [tenure] <= 12 then "0-12 months" else if [tenure] <= 24 then "13-24 months" else if [tenure] <= 48 then "25-48 months" else "49-72 months", type text),
				    BandOrder = Table.AddColumn(Band, "Tenure Band Order", each if [tenure] <= 12 then 1 else if [tenure] <= 24 then 2 else if [tenure] <= 48 then 3 else 4, Int64.Type),
				    ContractOrder = Table.AddColumn(BandOrder, "Contract Order", each if [Contract] = "Month-to-month" then 1 else if [Contract] = "One year" then 2 else 3, Int64.Type),
				    AddOns = Table.AddColumn(ContractOrder, "Protective Add-ons", each if [InternetService] = "No" then "No internet" else Text.From(List.Count(List.Select({[OnlineSecurity], [OnlineBackup], [DeviceProtection], [TechSupport]}, (v) => v = "Yes"))) & " of 4", type text),
				    AddOnOrder = Table.AddColumn(AddOns, "Add-ons Order", each if [InternetService] = "No" then 9 else List.Count(List.Select({[OnlineSecurity], [OnlineBackup], [DeviceProtection], [TechSupport]}, (v) => v = "Yes")), Int64.Type),
				    Internet = Table.AddColumn(AddOnOrder, "Internet", each if [InternetService] = "No" then "No internet" else [InternetService], type text),
				    Charge = Table.AddColumn(Internet, "Charge Band", each let m = [MonthlyCharges] in if m < 35 then "Under $35" else if m < 70 then "$35-70" else if m < 90 then "$70-90" else "$90+", type text),
				    ChargeOrder = Table.AddColumn(Charge, "Charge Band Order", each let m = [MonthlyCharges] in if m < 35 then 1 else if m < 70 then 2 else if m < 90 then 3 else 4, Int64.Type),
				    Segment = Table.AddColumn(ChargeOrder, "Segment", each [Contract] & " | " & [Internet] & " | " & [PaymentMethod], type text),
				    ChurnFlag = Table.AddColumn(Segment, "Churn Flag", each if [Churn] = "Yes" then 1 else 0, Int64.Type),
				    Result = Table.SelectColumns(ChurnFlag, {"customerID", "Senior Citizen", "Partner", "Dependents", "tenure", "Tenure Band", "Tenure Band Order", "Internet", "OnlineSecurity", "TechSupport", "Protective Add-ons", "Add-ons Order", "Contract", "Contract Order", "PaymentMethod", "PaperlessBilling", "MonthlyCharges", "Charge Band", "Charge Band Order", "Segment", "Churn", "Churn Flag"})
				in
				    Result

