                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "- Cart events are recorded at three different daily levels (about 18K, 40K and 72K). On 19 days purchases exceed carts, so cart-based rates are unreliable. View to purchase is the safer measure.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1640"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "- 15 Nov 2019 has 5.7M views but zero purchase events.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1640"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "- Times are UTC. Distinct users and sessions are counted per period and are never added up.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
