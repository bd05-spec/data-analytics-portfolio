                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "- Purchase value = sum of item prices on purchase events. There is no revenue, quantity or discount field.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#1F1640"
                    }
