                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Attrition is front-loaded. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#2B2420"
                    }
                  },
                  {
                    "value": "34.9% of first-year staff and 35.8% of under-25s leave, vs 16.1% overall.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#2B2420"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#2B2420"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Leavers earn less. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#2B2420"
                    }
                  },
                  {
                    "value": "Median monthly pay is $3,202 for leavers vs $5,204 for stayers.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#2B2420"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "4pt",
                      "color": "#2B2420"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Biggest lever: overtime. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "color": "#2B2420"
                    }
                  },
                  {
                    "value": "30.5% attrition with overtime vs 10.4% without; see the Action plan page.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#2B2420"
                    }
                  }
                ]
              }
